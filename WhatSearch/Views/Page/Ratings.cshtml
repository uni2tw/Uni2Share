@{
    this.Layout = "_Layout.cshtml";
}

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            const App = {
                data() {
                    return {
                        loaded: false,
                        failed: false,
                        data: null,
                        scanning: false,
                        deleting: false,
                        scan: null,
                        selected: {},
                        transferTo: '',
                        transferOverwrite: false,
                        transferring: false,
                        purging: false
                    }
                },
                computed: {
                    enabled: function () {
                        return !!this.data && (this.data.animeShares.length > 0 || this.data.albumShares.length > 0);
                    },
                    orphans: function () {
                        return this.scan ? this.scan.orphans : [];
                    },
                    selectedKeys: function () {
                        var self = this;
                        return this.orphans.filter(function (o) { return self.selected[o.key]; }).map(function (o) { return o.key; });
                    },
                    allSelected: function () {
                        return this.orphans.length > 0 && this.selectedKeys.length === this.orphans.length;
                    }
                },
                mounted: function () {
                    this.vm_load();
                },
                methods: {
                    vm_home: function () {
                        location.href = '/page';
                    },
                    vm_showAlert: function (text) {
                        var el = document.querySelector('.alert');
                        el.textContent = text;
                        el.style.display = 'block';
                        el.style.opacity = '1';
                        window.setTimeout(function () {
                            el.style.transition = 'opacity 0.4s';
                            el.style.opacity = '0';
                            window.setTimeout(function () {
                                el.style.display = 'none';
                            }, 400);
                        }, 4000);
                    },
                    vm_load: function () {
                        var self = this;
                        axios.get('/admin/ratings/data').then(function (res) {
                            // 登入失效時伺服器會轉去登入頁，拿到的是 HTML 不是資料
                            if (!res.data || !Array.isArray(res.data.animeShares)) {
                                self.failed = true;
                                return;
                            }
                            self.data = res.data;
                            self.failed = false;
                            self.loaded = true;
                        }).catch(function () {
                            self.failed = true;
                        });
                    },
                    vm_scan: function () {
                        var self = this;
                        self.scanning = true;
                        axios.post('/admin/ratings/scan', {}).then(function (res) {
                            if (!res.data || !Array.isArray(res.data.orphans)) {
                                self.vm_showAlert('檢查失敗，請重新登入後再試');
                                return;
                            }
                            self.scan = res.data;
                            self.selected = {};
                            self.data.total = res.data.total;
                        }).catch(function () {
                            self.vm_showAlert('檢查失敗，請稍後再試');
                        }).finally(function () {
                            self.scanning = false;
                        });
                    },
                    vm_toggleAll: function () {
                        var on = !this.allSelected, sel = {};
                        this.orphans.forEach(function (o) { sel[o.key] = on; });
                        this.selected = sel;
                    },
                    vm_delete: function () {
                        var self = this, keys = this.selectedKeys;
                        if (keys.length === 0) {
                            return;
                        }
                        if (!window.confirm('確定要刪除選取的 ' + keys.length + ' 筆評分嗎？（所有人的這幾個項目的評分都會刪掉）\n刪除前會先備份評分檔。')) {
                            return;
                        }
                        self.deleting = true;
                        axios.post('/admin/ratings/delete', { keys: keys }).then(function (res) {
                            var d = res.data || {};
                            self.vm_showAlert(d.message || '刪除失敗');
                            if (d.success === 1) {
                                // 伺服器已重新檢查過，沒刪到的（資料夾又找得到了）重新檢查才會正確顯示
                                self.vm_scan();
                            }
                        }).catch(function () {
                            self.vm_showAlert('刪除失敗，請稍後再試');
                        }).finally(function () {
                            self.deleting = false;
                        });
                    },
                    vm_kind: function (kind) {
                        return kind === 'album' ? '專輯' : '動畫';
                    },
                    vm_pct: function (n, total) {
                        return total > 0 ? Math.round(n * 100 / total) : 0;
                    },
                    vm_maxCount: function () {
                        return this.data.insights.users.reduce(function (m, u) { return Math.max(m, u.count); }, 0);
                    },
                    vm_distMax: function (u) {
                        return Math.max.apply(null, u.dist.concat([1]));
                    },
                    vm_distTip: function (u) {
                        return u.dist.map(function (n, i) { return ((i + 5) / 2) + ' 星 ' + n + ' 筆'; }).join('\n');
                    },
                    vm_kindText: function (kind) {
                        return kind === 'album' ? '專輯' : '動畫';
                    },
                    vm_purge: function () {
                        var self = this;
                        var gone = self.data.users.filter(function (u) { return !u.exists; });
                        if (!gone.length) {
                            return;
                        }
                        var n = gone.reduce(function (s, u) { return s + u.count; }, 0);
                        var text = '要清除已刪除會員的評分嗎？\n\n'
                            + gone.map(function (u) { return '・' + u.name + '：' + u.count + ' 筆'; }).join('\n') + '\n\n'
                            + '共 ' + n + ' 筆，清除後無法在頁面上復原（清之前會先備份 ratings.users.json）。';
                        if (!window.confirm(text)) {
                            return;
                        }
                        self.purging = true;
                        axios.post('/admin/ratings/purge-deleted', {}).then(function (res) {
                            var d = res.data || {};
                            self.vm_showAlert(d.message || '清除失敗');
                            if (d.success === 1) {
                                self.scan = null;
                                self.vm_load();
                            }
                        }).catch(function () {
                            self.vm_showAlert('清除失敗，請稍後再試');
                        }).finally(function () {
                            self.purging = false;
                        });
                    },
                    vm_transfer: function () {
                        var self = this, to = self.transferTo;
                        if (!to || !self.data || !self.data.legacy) {
                            return;
                        }
                        var text = '要把舊的共用評分 ' + self.data.legacy + ' 筆轉給「' + to + '」嗎？\n\n'
                            + '・轉完這些評分變成「' + to + '」自己的，舊的共用評分清空（其他人不會再看到）。\n'
                            + '・' + (self.transferOverwrite ? '對方已經評過的項目會被舊評分覆蓋。' : '對方已經評過的項目保留他自己的。') + '\n'
                            + '・轉之前會先備份 ratings.json。';
                        if (!window.confirm(text)) {
                            return;
                        }
                        self.transferring = true;
                        axios.post('/admin/ratings/transfer', { to: to, overwrite: self.transferOverwrite }).then(function (res) {
                            var d = res.data || {};
                            self.vm_showAlert(d.message || '轉移失敗');
                            if (d.success === 1) {
                                self.scan = null;
                                self.vm_load();
                            }
                        }).catch(function () {
                            self.vm_showAlert('轉移失敗，請稍後再試');
                        }).finally(function () {
                            self.transferring = false;
                        });
                    }
                }
            };
            window.app = Vue.createApp(App).mount('#main');
        });
    </script>

<body>
    <div id="main" class="container" style="max-width:1000px; padding-top:16px; padding-bottom:40px;" v-cloak>
        <div class="alert alert-info" style="display:none; margin-bottom:10px"></div>
        <h1 class="h3" style="display:flex; align-items:center; gap:10px;">
            <button type="button" class="btn btn-sm btn-info" v-on:click="vm_home()" title="回首頁"><i class="fa fa-home"></i></button>
            評分管理
            <span style="margin-left:auto; display:flex; gap:6px; flex-wrap:wrap; justify-content:flex-end;">
                <a href="/admin" class="btn btn-sm btn-outline-secondary"><i class="fa fa-users"></i> 會員管理</a>
                <a href="/admin/monitor" class="btn btn-sm btn-outline-secondary"><i class="fa fa-chart-line"></i> 播放監控</a>
                <a href="/admin/security" class="btn btn-sm btn-outline-secondary"><i class="fa fa-shield-halved"></i> 異常請求</a>
                <a href="/admin/convert" class="btn btn-sm btn-outline-secondary"><i class="fa fa-film"></i> MKV 轉檔</a>
            </span>
        </h1>
        <div style="font-size:13px; color:#666; margin:0 0 12px 0; line-height:1.7;">
            評分每位會員一份，記在 <code>data\ratings.users.json</code>，以資料夾「名稱」對應。資料夾改名時系統會自動讓所有人的評分跟著新名稱走（需要伺服器正在執行、檔案監看有收到事件）；
            名稱對不上的（伺服器沒開時改的名、已刪除、搬出分享根）會變成找不到資料夾的評分。「檢查」會走訪分享根的資料夾，網路磁碟上可能要一段時間；
            刪除前會先備份評分檔（各最近 10 份）。
            <span v-if="failed" style="color:#dc3545;"><i class="fa fa-triangle-exclamation"></i> 載入失敗</span>
        </div>

        <div v-if="!loaded" style="color:#888; padding:20px 0;">載入中…</div>

        <div v-else>
            <div v-if="data.insights.users.length" class="card" style="margin-bottom:14px;">
                <div class="card-body" style="font-size:13px; line-height:1.7;">
                    <div style="font-weight:bold; margin-bottom:6px;"><i class="fa fa-ranking-star"></i> 評分貢獻排名</div>
                    <div style="overflow-x:auto;">
                        <table class="table table-sm" style="margin:0; min-width:560px;">
                            <thead>
                                <tr style="color:#888; font-size:12px;">
                                    <th style="width:34px;">#</th>
                                    <th>會員</th>
                                    <th style="min-width:160px;">筆數</th>
                                    <th>動畫</th>
                                    <th>專輯</th>
                                    <th>平均</th>
                                    <th>星等分布（2.5 → 5）</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(u, i) in data.insights.users" :key="u.name" :style="u.exists ? '' : 'color:#999;'">
                                    <td>{{ i + 1 }}</td>
                                    <td>{{ u.name }}<span v-if="!u.exists" style="font-size:11px; margin-left:4px;">（已刪除）</span></td>
                                    <td>
                                        <span style="display:inline-block; vertical-align:middle; height:10px; border-radius:2px; background:#0d6efd; min-width:2px;" :style="{ width: (vm_maxCount() ? Math.round(u.count * 100 / vm_maxCount()) : 0) + 'px', opacity: u.exists ? 1 : 0.4 }"></span>
                                        <b style="margin-left:4px;">{{ u.count }}</b>
                                        <span style="color:#888; font-size:12px;">（{{ vm_pct(u.count, data.insights.users.reduce(function (s, x) { return s + x.count; }, 0)) }}%）</span>
                                    </td>
                                    <td>{{ u.anime }}</td>
                                    <td>{{ u.album }}</td>
                                    <td>{{ u.count ? u.avg.toFixed(2) : '-' }}</td>
                                    <td>
                                        <span style="display:inline-flex; align-items:flex-end; gap:2px; height:24px;" :title="vm_distTip(u)">
                                            <span v-for="(n, k) in u.dist" :key="k" style="display:inline-block; width:7px; border-radius:1px; background:#f0ad4e;" :style="{ height: Math.max(n ? 2 : 0, Math.round(n * 24 / vm_distMax(u))) + 'px', opacity: u.exists ? 1 : 0.4 }"></span>
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="color:#888; font-size:12px; margin-top:4px;">只算每位會員自己的評分（大於 0 的）；舊的共用評分不算。</div>
                    <div v-if="data.insights.mostRated.length" style="display:flex; gap:24px; flex-wrap:wrap; margin-top:12px;">
                        <div style="flex:1 1 320px; min-width:0;">
                            <div style="font-weight:bold; margin-bottom:4px;">最多人評過</div>
                            <div v-for="(r, i) in data.insights.mostRated" :key="'m' + i" style="padding:2px 0; border-top:1px solid #eee;">
                                <span style="color:#888;">{{ i + 1 }}.</span> {{ r.name }} <span style="font-size:11px; color:#888;">［{{ vm_kindText(r.kind) }}］</span>
                                <div style="color:#666; font-size:12px; padding-left:18px;">{{ r.count }} 人評過・平均 {{ r.avg.toFixed(2) }}・{{ r.detail }}</div>
                            </div>
                        </div>
                        <div style="flex:1 1 320px; min-width:0;">
                            <div style="font-weight:bold; margin-bottom:4px;">分歧最大</div>
                            <div v-if="!data.insights.divergent.length" style="color:#888; font-size:12px;">目前大家評得一樣，沒有分歧。</div>
                            <div v-for="(r, i) in data.insights.divergent" :key="'d' + i" style="padding:2px 0; border-top:1px solid #eee;">
                                <span style="color:#888;">{{ i + 1 }}.</span> {{ r.name }} <span style="font-size:11px; color:#888;">［{{ vm_kindText(r.kind) }}］</span>
                                <div style="color:#666; font-size:12px; padding-left:18px;">相差 {{ r.spread }} 星・{{ r.detail }}</div>
                            </div>
                        </div>
                    </div>
                    <div v-else style="color:#888; font-size:12px; margin-top:8px;">還沒有被兩位以上會員評過的作品，所以沒有「最多人評過」與「分歧最大」。</div>
                </div>
            </div>
            <div v-if="data.users.some(function (u) { return !u.exists; })" class="card" style="margin-bottom:14px;">
                <div class="card-body" style="font-size:13px; line-height:1.8;">
                    <div style="font-weight:bold; margin-bottom:4px;"><i class="fa fa-user-slash"></i> 已刪除的會員還留著評分</div>
                    <div style="color:#666; margin-bottom:8px;">
                        {{ data.users.filter(function (u) { return !u.exists; }).map(function (u) { return u.name + ' ' + u.count + ' 筆'; }).join('、') }}。
                        這些會員已經不存在，評分不會再被任何人看到，可以直接清掉（清之前會先備份）。
                    </div>
                    <button type="button" class="btn btn-sm btn-warning" :disabled="purging" v-on:click="vm_purge()">
                        <i class="fa" :class="purging ? 'fa-spinner fa-spin' : 'fa-trash'"></i> 清除這些評分
                    </button>
                </div>
            </div>
            <div v-if="data.legacy > 0" class="card" style="margin-bottom:14px;">
                <div class="card-body" style="font-size:13px; line-height:1.8;">
                    <div style="font-weight:bold; margin-bottom:4px;"><i class="fa fa-right-left"></i> 舊的共用評分還有 {{ data.legacy }} 筆</div>
                    <div style="color:#666; margin-bottom:8px;">
                        這是改成「每人一份」之前全站共用的評分（<code>data\ratings.json</code>）。會員自己沒評過的項目目前還看得到它。
                        轉給某位會員後，這些評分就變成他自己的，舊的共用評分清空，其他人不會再看到。
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <select class="form-select form-select-sm" style="width:auto; min-width:160px;" v-model="transferTo" :disabled="transferring">
                            <option value="">選擇要轉給誰…</option>
                            <option v-for="u in data.users" :key="u.name" :value="u.name" :disabled="!u.exists">{{ u.display && u.display !== u.name ? u.display + '（' + u.name + '）' : u.name }}　已有 {{ u.count }} 筆</option>
                        </select>
                        <label style="cursor:pointer; user-select:none; margin:0;"><input type="checkbox" v-model="transferOverwrite" :disabled="transferring"> 對方已有的也覆蓋</label>
                        <button type="button" class="btn btn-sm btn-warning" :disabled="!transferTo || transferring" v-on:click="vm_transfer()">
                            <i class="fa" :class="transferring ? 'fa-spinner fa-spin' : 'fa-right-left'"></i> 轉給他
                        </button>
                    </div>
                </div>
            </div>
            <div v-if="!enabled" style="color:#b26a00; padding:8px 0;">
                <i class="fa fa-triangle-exclamation"></i> 目前沒有啟用評分（config 的 rating.shares／rating.albums.shares），沒有可檢查的項目。
            </div>
            <div v-else>
                <div style="font-size:13px; color:#666; margin-bottom:10px; line-height:1.8;">
                    共 <b>{{ data.total }}</b> 筆評分<span v-if="data.users.some(function (u) { return u.count > 0; })">（{{ data.users.filter(function (u) { return u.count > 0; }).map(function (u) { return u.name + ' ' + u.count; }).join('、') }}<span v-if="data.legacy > 0">、舊共用 {{ data.legacy }}</span>）</span>
                    <span v-if="data.animeShares.length">；動畫分享根：{{ data.animeShares.join('、') }}</span>
                    <span v-if="data.albumShares.length">；專輯分享根：{{ data.albumShares.join('、') }}</span>
                </div>
                <div style="display:flex; align-items:center; gap:6px; margin-bottom:10px; flex-wrap:wrap;">
                    <button type="button" class="btn btn-sm btn-primary" :disabled="scanning || deleting" v-on:click="vm_scan()">
                        <i class="fa" :class="scanning ? 'fa-spinner fa-spin' : 'fa-magnifying-glass'"></i> {{ scanning ? '檢查中…' : '檢查' }}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" :disabled="selectedKeys.length === 0 || deleting || scanning" v-on:click="vm_delete()">
                        <i class="fa fa-trash"></i> 刪除選取的 {{ selectedKeys.length }} 筆
                    </button>
                </div>

                <div v-if="scan">
                    <div v-for="e in scan.errors" :key="e" style="color:#b26a00; font-size:13px; margin-bottom:6px;">
                        <i class="fa fa-triangle-exclamation"></i> {{ e }}
                    </div>
                    <div style="font-size:13px; color:#666; margin-bottom:6px;">
                        <span v-if="scan.animeChecked || scan.albumChecked">
                            已檢查{{ scan.animeChecked ? '動畫' : '' }}{{ scan.animeChecked && scan.albumChecked ? '、' : '' }}{{ scan.albumChecked ? '專輯' : '' }}；找不到資料夾的有 <b>{{ orphans.length }}</b> 筆
                        </span>
                    </div>
                    <div v-if="(scan.animeChecked || scan.albumChecked) && orphans.length === 0" style="color:#198754; padding:10px 0;">
                        <i class="fa fa-circle-check"></i> 沒有找不到資料夾的評分。
                    </div>
                    <div v-if="orphans.length > 0" class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr style="font-size:13px; color:#888;">
                                    <th style="width:32px;"><input type="checkbox" :checked="allSelected" v-on:change="vm_toggleAll()" title="全選／取消"></th>
                                    <th style="white-space:nowrap;">類型</th>
                                    <th>名稱</th>
                                    <th style="white-space:nowrap;">誰評了多少</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="o in orphans" :key="o.key">
                                    <td><input type="checkbox" v-model="selected[o.key]"></td>
                                    <td style="font-size:13px; white-space:nowrap;">
                                        <span class="badge" :class="o.kind === 'album' ? 'bg-info' : 'bg-secondary'">{{ vm_kind(o.kind) }}</span>
                                    </td>
                                    <td style="word-break:break-all;">{{ o.name }}</td>
                                    <td style="font-size:13px; white-space:nowrap;">{{ o.detail || (o.rating > 0 ? o.rating + ' 星' : '未評分') }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div v-else style="color:#888; padding:10px 0;">按「檢查」找出找不到資料夾的評分。</div>
            </div>
        </div>
    </div>
</body>
